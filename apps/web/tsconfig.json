{
  "extends": "../../packages/config/typescript/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@probetes/types": [
        "../../packages/types/src/index.ts"
      ],
      "@probetes/ui": [
        "../../packages/ui/src/index.ts"
      ]
    },
    "moduleResolution": "Bundler",
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
